# spike build outputs (runner-generated, never commit)
spike/out/
# phase3 gate suite outputs (runner-generated, never commit)
phase3/out/
# phase4 runtime host outputs: payload engine, evidence, build intermediates
phase4/out/
# phase5 client-integration outputs (host MCP fixture + node_modules + evidence)
phase5/out/
app/build/
build/
.gradle/
local.properties
*.apk
!app/build/outputs/**/.gitkeep
.DS_Store
phase6/out/
# phase7 workspace/memory gate outputs (runner-generated, never commit)
phase7/out/

# python bytecode caches created by the phase gate checkers (never commit)
__pycache__/
*.pyc
phase8/out/
phase9/out/
p8d-out/**/*.apk

# PHASE 10 - release signing material. These must NEVER be committed: the upload
# keystore is generated by the human owner on a machine they control, and its
# passwords live in keystore.properties (gitignored here) or in the environment.
# docs/RELEASE.md is the procedure; check-release-invariants.py is the gate.
keystore.properties
*.jks
*.keystore
*.p12
*.pepk
# the AAB/APK signing outputs of a local release build
phase10/out/
phase10/signing/
