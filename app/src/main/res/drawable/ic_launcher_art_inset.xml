<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive foreground (API 26+): the app icon artwork, unedited, placed inside the 108 dp canvas.
  The 14 dp inset keeps the rounded tile inside the 72 dp visible area of the launcher mask.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_launcher_art"
    android:inset="14dp"/>
