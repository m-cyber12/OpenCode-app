<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (API 26+), from the upstream OpenCode icon set
  (packages/desktop/icons/prod/android/mipmap-anydpi-v26/ic_launcher.xml at the
  pinned commit). Used here under the branding arrangement described in
  docs/BRANDING.md: the app is an independent client of the OpenCode project and
  ships the project's own icon and name unchanged, pending the project's explicit
  permission. If that permission is not granted, the fallback is to swap ONLY the
  resources below plus the display name - never the application ID.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
  <background android:drawable="@color/ic_launcher_background"/>
</adaptive-icon>
