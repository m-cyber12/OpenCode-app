<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (API 26+). The OpenCode app's own icon: a silver plate on a
  dark tile. Master artwork: docs/brand/app-icon.svg. The foreground and background are
  vector drawables derived from it, so the icon stays sharp at every size.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@drawable/ic_launcher_background"/>
  <foreground android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
