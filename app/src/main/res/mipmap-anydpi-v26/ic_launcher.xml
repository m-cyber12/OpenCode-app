<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (API 26+). The app icon is the uploaded artwork, used without edits
  (app/src/main/res/drawable-nodpi/ic_launcher_art.png). Its corners are transparent, so the
  background is transparent too and the artwork is shown as designed.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@android:color/transparent"/>
  <foreground android:drawable="@drawable/ic_launcher_art_inset"/>
</adaptive-icon>
