<?xml version="1.0" encoding="utf-8"?>
<!--
  OpenCode Android app — Phase 4 runtime host.

  Foreground service rationale (required by phase rules): the embedded OpenCode
  server is a long-running user agent — agent turns, shell commands and MCP
  servers keep running after the user leaves the chat screen. Without a
  foreground service Android can kill the process on background/doze, killing
  in-flight agent work and child processes. RuntimeService therefore runs as a
  foreground service with a low-priority, dismissible notification so the user
  knows the agent is alive. Type specialUse (persistent local compute, not one
  of the narrow platform categories) with the required justification string.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET: the embedded OpenCode server listens on 127.0.0.1:4111 and
         is reached over loopback (health checks, app UI, SDK client); loopback
         TCP still requires this permission — without it the UID is denied by
         netd and connects fail with EPERM (observed in CI gate runs). The
         network security config permits cleartext for loopback ONLY. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- MANAGE_EXTERNAL_STORAGE ("All files access"): the deliberately chosen
         trade of Phase 10 continuation v3. Project files must be ordinary,
         user-visible files — a real folder that any file manager, the Files app,
         MTP and a non-root `adb shell` can open while the agent is working.

         Why nothing narrower works, rather than an argument for the broad one:
         the previous answers were (a) app-private storage, invisible to
         everything, and (b) the app-specific external directory, which `adb`/MTP
         can reach but *file managers cannot on Android 11+*, because the
         platform blocks one app from browsing another's Android/data. A
         Storage Access Framework tree would put the copy outside the sandbox,
         but its `content://` grant is not a POSIX path, and the embedded
         OpenCode runtime is a real process (git, bun, ripgrep, its own bash
         tool) that needs a path to `chdir` into; a SAF-only root would mean
         either re-engineering the runtime's file layer (out of scope, and it
         would diverge from upstream) or handing the agent a directory it cannot
         actually write to.

         What this permission is used FOR, exactly: read/write/rename/delete
         inside Documents/OpenCode (the default project root), plus the
         user-chosen folder if they pick one with the system picker. Nothing
         else is walked, and no media outside the project roots is read. The
         in-app panel offers the narrower alternatives (choose a folder /
         keep everything in the app folder) for users who do not want to grant
         it, and says plainly what each one costs in visibility.

         Scope note: this is a Play policy matter, not just a manifest line —
         the release ships with the "All files access" declaration and the
         in-app reason above (see docs/progress/, Phase 10 continuation v3).

         maxSdkVersion is deliberately ABSENT: the permission is the default
         mechanism on every supported version >= 30, and on API 29 and below the
         app does not need it at all (the app-specific external directory is
         itself file-manager-visible there, so the fallback is not a downgrade). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:extractNativeLibs="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.OpenCodeApp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.OpenCodeApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".runtime.RuntimeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Embedded OpenCode agent runtime: long-running local AI agent with shell/git/MCP child processes that must survive backgrounding and doze." />
        </service>

        <!-- Debug/test hooks: gated on BuildConfig.DEBUG inside the class.
             Lets CI stop/restart/reset the runtime via adb without root.
             The Activity is the reliable path (a background manifest receiver
             is deferred on API 34); the receiver is kept as a fallback. -->
        <activity
            android:name=".runtime.DebugControlActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:stateNotNeeded="true" />
        <receiver
            android:name=".runtime.DebugControlReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="ai.opencode.android.DEBUG_STOP" />
                <action android:name="ai.opencode.android.DEBUG_RESET" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
